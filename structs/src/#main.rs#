
use std::io;

struct Volume {
    length: f64,
    height: f64,
    width: f64,
}

impl Volume {
    fn input(&mut self) -> f64 {
        let mut inpt = String::new();
        io::stdin().read_line(&mut inpt).unwrap();
        
        let mut iter = inpt.split_whitespace().map(|x| x.parse::<f64>().unwrap());

        self.length = iter.next().expect("Enter length");
        self.height = iter.next().expect("Enter height");
        self.width = iter.next().expect("Enter width");

        self.length * self.height * self.width
    }
}

fn main() {
    let mut vol = Volume { length: 0.0, height: 0.0, width: 0.0 };
    println!("Volume is: {}^3", vol.input());
}
